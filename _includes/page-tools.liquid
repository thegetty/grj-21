{%- if contributor.length == 1 -%}

  {%- capture chicagoContributor -%}
    {{ contributor[0].first_name }} {{ contributor[0].last_name }}
  {%- endcapture -%}

  {%- capture mlaContributor -%}
    {{ contributor[0].last_name }}, {{ contributor[0].first_name }}
  {%- endcapture -%}

  {%- assign lastCharacter = contributor[0].first_name | slice: -1,1 -%}

{%- elsif contributor.length == 2 -%}

  {%- capture chicagoContributor -%}
    {{ contributor[0].first_name }} {{ contributor[0].last_name }} and {{ contributor[1].first_name }} {{ contributor[1].last_name }}
  {%- endcapture -%}

  {%- capture mlaContributor -%}
    {{ contributor[0].last_name }}, {{ contributor[0].first_name }}, and {{ contributor[1].first_name }} {{ contributor[1].last_name }}
  {%- endcapture -%}

  {%- assign lastCharacter = contributor[1].first_name | slice: -1,1 -%}

{%- else -%}

  {%- if contributor.length <= 6 -%}
    
    {%- capture chicagoContributor -%}
      {%- for person in contributor -%}
        {%- if forloop.first -%}
          {{ person.first_name }} {{ person.last_name }}, {% elsif forloop.last -%}
          and {{ person.first_name }} {{ person.last_name }}{%- else -%}
          {{ person.first_name }} {{ person.last_name }}, {% endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign lastCharacter = contributor[contributor.length-1].first_name | slice: -1,1 -%}

  {%- else -%}

    {%- capture chicagoContributor -%}
      {{ contributor[0].first_name }} {{ contributor[0].last_name }}, {{ contributor[1].first_name }} {{ contributor[1].last_name }}, and {{ contributor[2].first_name }} {{ contributor[2].last_name }} et al.
    {%- endcapture -%}

    {%- assign lastCharacter = contributor[2].first_name | slice: -1,1 -%}

  {%- endif -%}

  {%- capture mlaContributor -%}
    {{ contributor[0].last_name }}, {{ contributor[0].first_name }}, et al
  {%- endcapture -%}

{%- endif -%}

{%- if lastCharacter == "." -%}
  {%- assign mlaContributorBreak = "" -%}
{%- else -%}
  {%- assign mlaContributorBreak = "." -%}
{%- endif -%}
<section class="quire-page__content page-tools" aria-label="Article download, abstract, and citation" data-outputs-exclude="epub,pdf">
  <div class="container">
    <div class="content">
      {% if abstract %}
      {% accordion 'Abstract' %}

      {{ abstract | markdownify }} 

      {% if keywords %}

      Keywords {.page-tools__heading}

      {{ keywords | markdownify }}

      {% endif %}
      {% endaccordion %}
      {% endif %}
      {% if peer_review %}
      {% accordion 'Peer Review' %}

      {{  peer_review  | markdownify }}
      
      {% endaccordion %}
      {% endif %}
      {% if doi %}
      {% accordion 'Cite' %}

      {%- assign citationTitle = title | replace: '“', '‘' | replace: '”', '’' -%}
      {%- assign citationSubtitle = subtitle | replace: '“', '‘' | replace: '”', '’' -%}
    
      **Chicago**
      {{ chicagoContributor }}, “{% pageTitle title=citationTitle subtitle=citationSubtitle %},” *{{ publication.title }}*, no. {{ publication.series_issue_number }} ({{ publication.pub_date | date: "%Y" }}), {{ doi }}.
      
      **MLA**
      {{ mlaContributor }}{{ mlaContributorBreak }} “{% pageTitle title=citationTitle subtitle=citationSubtitle %}.” *{{ publication.title }}*, no. {{ publication.series_issue_number }}, {{ publication.pub_date | date: "%Y" }}, {{ doi }}.
      
      {{ copyright | markdownify }}
      {% endaccordion %}
      {% endif %}
    </div>
  </div>
</section>
